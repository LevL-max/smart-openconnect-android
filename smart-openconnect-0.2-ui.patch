+    private Fragment fragmentFor(int tab) {
+        switch (tab) {
+        case TAB_SERVERS: return new VPNProfileList();
+        case TAB_LOG: return new LogFragment();
+        case TAB_CONNECT:
+        default: return new ConnectFragment();
+        }
+    }
