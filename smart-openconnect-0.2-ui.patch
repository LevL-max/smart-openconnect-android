+/* Android Smart Relay: libopenconnect keeps the logical hostname, while this
+ * getaddrinfo override pins only that hostname to the relay IP selected by the
+ * Java health checker. SNI, certificate callbacks and HTTP Host therefore keep
+ * using the original DNS name. */
+static int smart_relay_getaddrinfo(void *cbdata, const char *node,
+                                  const char *service,
+                                  const struct addrinfo *hints,
+                                  struct addrinfo **res)
+{
+	struct libctx *ctx = cbdata;
+
+	if (ctx && ctx->resolve_host && ctx->resolve_ip && node &&
+	    !strcasecmp(node, ctx->resolve_host))
+		return getaddrinfo(ctx->resolve_ip, service, hints, res);
+
+	return getaddrinfo(node, service, hints, res);
+}
