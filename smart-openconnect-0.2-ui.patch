+/*
+ * Thumb-friendly Connect screen for Smart OpenConnect.
+ * GPLv2+; part of the OpenConnect Android derivative.
+ */
+package net.openconnect_vpn.android.fragments;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import android.app.Fragment;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+import android.preference.PreferenceManager;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageButton;
+import android.widget.TextView;
+
+import net.openconnect_vpn.android.MainActivity;
+import net.openconnect_vpn.android.R;
+import net.openconnect_vpn.android.VpnProfile;
+import net.openconnect_vpn.android.api.GrantPermissionsActivity;
+import net.openconnect_vpn.android.core.OpenConnectManagementThread;
+import net.openconnect_vpn.android.core.OpenVpnService;
+import net.openconnect_vpn.android.core.ProfileManager;
+import net.openconnect_vpn.android.core.VPNConnector;
+
+public class ConnectFragment extends Fragment {
+    public static final String PREF_SELECTED_PROFILE = "selected_profile_uuid";
+
+    private View mView;
+    private ImageButton mConnectButton;
+    private View mServerButton;
+    private TextView mState;
+    private TextView mUptime;
+    private TextView mTunnelIp;
+    private TextView mRelayIp;
+    private TextView mDownloadSpeed;
+    private TextView mDownloadTotal;
+    private TextView mUploadSpeed;
+    private TextView mUploadTotal;
+    private TextView mServerName;
+    private TextView mServerAddress;
+    private TextView mRelay;
+    private VPNConnector mConn;
+    private SharedPreferences mAppPrefs;
+    private int mConnectionState = OpenConnectManagementThread.STATE_DISCONNECTED;
+
+    @Override
+    public View onCreateView(LayoutInflater inflater, ViewGroup container, Bundle state) {
+        mView = inflater.inflate(R.layout.connect, container, false);
+        mAppPrefs = PreferenceManager.getDefaultSharedPreferences(getActivity());
+        mConnectButton = (ImageButton)mView.findViewById(R.id.connect_button);
+        mServerButton = mView.findViewById(R.id.selected_server_button);
+        mState = (TextView)mView.findViewById(R.id.connect_state);
+        mUptime = (TextView)mView.findViewById(R.id.connection_time);
+        mTunnelIp = (TextView)mView.findViewById(R.id.tunnel_ip_value);
+        mRelayIp = (TextView)mView.findViewById(R.id.relay_ip_value);
+        mDownloadSpeed = (TextView)mView.findViewById(R.id.download_speed);
+        mDownloadTotal = (TextView)mView.findViewById(R.id.download_total);
+        mUploadSpeed = (TextView)mView.findViewById(R.id.upload_speed);
+        mUploadTotal = (TextView)mView.findViewById(R.id.upload_total);
+        mServerName = (TextView)mView.findViewById(R.id.selected_server_name);
+        mServerAddress = (TextView)mView.findViewById(R.id.selected_server_address);
+        mRelay = (TextView)mView.findViewById(R.id.smart_relay_state);
+
+        mServerButton.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View v) {
+                ((MainActivity)getActivity()).showServersTab();
+            }
+        });
+
+        mConnectButton.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View v) {
+                if (mConnectionState != OpenConnectManagementThread.STATE_DISCONNECTED) {
+                    if (mConn != null && mConn.service != null)
+                        mConn.service.stopVPN();
+                    return;
+                }
+
+                VpnProfile profile = getSelectedProfile();
+                if (profile == null) {
+                    ((MainActivity)getActivity()).showServersTab();
+                    return;
+                }
+                selectProfile(profile);
+                Intent intent = new Intent(getActivity(), GrantPermissionsActivity.class);
+                intent.putExtra(getActivity().getPackageName() + GrantPermissionsActivity.EXTRA_UUID,
+                        profile.getUUIDString());
+                intent.setAction(Intent.ACTION_MAIN);
+                startActivity(intent);
+            }
+        });
+
+        mConn = new VPNConnector(getActivity(), false) {
+            @Override public void onUpdate(OpenVpnService service) {
+                mConnectionState = service.getConnectionState();
+                if (service.profile != null)
+                    selectProfile(service.profile);
+                updateUI(service);
+            }
+        };
+
+        updateUI(null);
+        return mView;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateUI(mConn == null ? null : mConn.service);
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mConn != null) {
+            mConn.unbind();
+            mConn = null;
+        }
+        super.onDestroyView();
+    }
+
+    private void selectProfile(VpnProfile profile) {
+        if (profile != null)
+            mAppPrefs.edit().putString(PREF_SELECTED_PROFILE, profile.getUUIDString()).apply();
+    }
+
+    private VpnProfile getSelectedProfile() {
+        String uuid = mAppPrefs.getString(PREF_SELECTED_PROFILE, null);
+        VpnProfile p = ProfileManager.get(uuid);
+        if (p != null)
+            return p;
+
+        VpnProfile last = ProfileManager.getLastConnectedVpn();
+        if (last != null) {
+            selectProfile(last);
+            return last;
+        }
+
+        List<VpnProfile> profiles = new ArrayList<VpnProfile>(ProfileManager.getProfiles());
+        Collections.sort(profiles);
+        if (profiles.isEmpty())
+            return null;
+        p = profiles.get(0);
+        selectProfile(p);
+        return p;
+    }
+
+    private void updateUI(OpenVpnService service) {
+        if (mView == null) return;
+        VpnProfile p = service != null && service.profile != null ? service.profile : getSelectedProfile();
+
+        if (p == null) {
+            mServerName.setText(R.string.no_profile_selected);
+            mServerAddress.setText(R.string.tap_to_choose_server);
+            mRelay.setText(R.string.smart_relay_no_profile);
+        } else {
+            String address = p.mPrefs.getString("server_address", "");
+            mServerName.setText(p.getName());
+            mServerAddress.setText(address);
+            boolean smart = p.mPrefs.getBoolean("smart_relay", true);
+            String ip = p.mPrefs.getString("smart_relay_last_selected_ip", "");
+            if (!smart)
+                mRelay.setText(R.string.smart_relay_off);
+            else if (ip.length() > 0)
+                mRelay.setText(getString(R.string.smart_relay_using, ip));
+            else
+                mRelay.setText(R.string.smart_relay_ready);
+        }
+
+        if (service != null) {
+            mConnectionState = service.getConnectionState();
+            mState.setText(service.getConnectionStateName());
+        } else {
+            mConnectionState = OpenConnectManagementThread.STATE_DISCONNECTED;
+            mState.setText(R.string.state_disconnected_short);
+        }
+
+        if (mConnectionState == OpenConnectManagementThread.STATE_CONNECTED) {
+            mConnectButton.setBackgroundResource(R.drawable.power_button_connected);
+            mConnectButton.setContentDescription(getString(R.string.disconnect));
+            mState.setTextColor(getResources().getColor(R.color.smart_green));
+            if (service != null && service.startTime != null)
+                mUptime.setText(OpenVpnService.formatElapsedTime(service.startTime.getTime()));
+            mTunnelIp.setText(service != null && service.ipInfo != null && service.ipInfo.addr != null
+                    ? service.ipInfo.addr : getString(R.string.value_unavailable));
+            updateTraffic();
+        } else if (mConnectionState == OpenConnectManagementThread.STATE_DISCONNECTED) {
+            mConnectButton.setBackgroundResource(R.drawable.power_button_disconnected);
+            mConnectButton.setContentDescription(getString(R.string.connect));
+            mState.setTextColor(getResources().getColor(R.color.text_primary));
+            mUptime.setText(R.string.tap_to_connect);
+            mTunnelIp.setText(R.string.value_unavailable);
+            clearTraffic();
+        } else {
+            mConnectButton.setBackgroundResource(R.drawable.power_button_connecting);
+            mConnectButton.setContentDescription(getString(R.string.cancel_connection));
+            mState.setTextColor(getResources().getColor(R.color.smart_amber));
+            mUptime.setText(R.string.working);
+            clearTraffic();
+        }
+
+        String relayIp = p == null ? "" : p.mPrefs.getString("smart_relay_last_selected_ip", "");
+        mRelayIp.setText(relayIp.length() == 0 ? getString(R.string.value_unavailable) : relayIp);
+    }
+
+    private void updateTraffic() {
+        if (mConn == null || !mConn.statsValid) {
+            clearTraffic();
+            return;
+        }
+        mDownloadSpeed.setText(OpenVpnService.humanReadableByteCount(mConn.deltaStats.rxBytes, true) + "/s");
+        mDownloadTotal.setText(getString(R.string.total_format,
+                OpenVpnService.humanReadableByteCount(mConn.newStats.rxBytes, false)));
+        mUploadSpeed.setText(OpenVpnService.humanReadableByteCount(mConn.deltaStats.txBytes, true) + "/s");
+        mUploadTotal.setText(getString(R.string.total_format,
+                OpenVpnService.humanReadableByteCount(mConn.newStats.txBytes, false)));
+    }
+
+    private void clearTraffic() {
+        mDownloadSpeed.setText(R.string.zero_speed);
+        mUploadSpeed.setText(R.string.zero_speed);
+        mDownloadTotal.setText(R.string.zero_total);
+        mUploadTotal.setText(R.string.zero_total);
+    }
+}
