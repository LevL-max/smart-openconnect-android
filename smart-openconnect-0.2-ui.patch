+JNIEXPORT jint JNICALL Java_org_infradead_libopenconnect_LibOpenConnect_setResolve(
+	JNIEnv *jenv, jobject jobj, jstring jhost, jstring jip)
+{
+	struct libctx *ctx = getctx(jenv, jobj);
+	const char *host = NULL, *ip = NULL;
+	char *new_host = NULL, *new_ip = NULL;
+
+	if (!ctx)
+		return -EINVAL;
+	if (get_cstring(jenv, jhost, &host) || get_cstring(jenv, jip, &ip))
+		goto out;
+
+	if (host && ip) {
+		new_host = strdup(host);
+		new_ip = strdup(ip);
+		if (!new_host || !new_ip) {
+			free(new_host);
+			free(new_ip);
+			new_host = new_ip = NULL;
+			OOM(jenv);
+			goto out;
+		}
+	}
+
+	free(ctx->resolve_host);
+	free(ctx->resolve_ip);
+	ctx->resolve_host = new_host;
+	ctx->resolve_ip = new_ip;
+
+	openconnect_override_getaddrinfo(ctx->vpninfo,
+		(ctx->resolve_host && ctx->resolve_ip) ? smart_relay_getaddrinfo : NULL);
+
+	release_cstring(jenv, jhost, host);
+	release_cstring(jenv, jip, ip);
+	return 0;
+
+out:
+	release_cstring(jenv, jhost, host);
+	release_cstring(jenv, jip, ip);
+	return -ENOMEM;
+}
