@@ -0,0 +1,436 @@
+/*
+ * Smart relay discovery/selection for OpenConnect for Android.
+ *
+ * This file is part of a GPLv2 derivative of OpenConnect for Android.
+ */
+package net.openconnect_vpn.android.core;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.security.cert.X509Certificate;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.SSLSocketFactory;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.X509TrustManager;
+
+/**
+ * Finds all relay IPs we can discover for a logical VPN hostname, probes them
+ * in parallel, and returns the fastest usable IP.  No credentials or HTTP
+ * application data are sent during probing.
+ *
+ * The selected IP is later installed into libopenconnect as a getaddrinfo()
+ * override.  The original DNS hostname remains untouched for TLS SNI,
+ * certificate handling and HTTP Host.
+ */
+public final class SmartRelaySelector {
+    public interface Logger {
+        void log(String line);
+    }
+
+    /** Allows VpnService to exempt probe sockets from an already-active VPN. */
+    public interface SocketProtector {
+        boolean protect(Socket socket);
+    }
+
+    public static final class Endpoint {
+        public final String host;
+        public final int port;
+
+        Endpoint(String host, int port) {
+            this.host = host;
+            this.port = port;
+        }
+    }
+
+    public static final class Candidate {
+        public final String ip;
+        public final boolean tcpOk;
+        public final boolean tlsOk;
+        public final long tcpMs;
+        public final long tlsMs;
+        public final String error;
+
+        Candidate(String ip, boolean tcpOk, boolean tlsOk,
+                  long tcpMs, long tlsMs, String error) {
+            this.ip = ip;
+            this.tcpOk = tcpOk;
+            this.tlsOk = tlsOk;
+            this.tcpMs = tcpMs;
+            this.tlsMs = tlsMs;
+            this.error = error;
+        }
+
+        long score() {
+            // TLS-confirmed nodes always rank ahead of TCP-only fallbacks.
+            long base = tlsOk ? 0 : (tcpOk ? 1_000_000L : 10_000_000L);
+            long latency = Math.max(0, tcpMs) + Math.max(0, tlsMs);
+            return base + latency;
+        }
+    }
+
+    public static final class Selection {
+        public final Endpoint endpoint;
+        public final String selectedIp;
+        public final List<Candidate> candidates;
+        public final String poolCsv;
+
+        Selection(Endpoint endpoint, String selectedIp,
+                  List<Candidate> candidates, String poolCsv) {
+            this.endpoint = endpoint;
+            this.selectedIp = selectedIp;
+            this.candidates = candidates;
+            this.poolCsv = poolCsv;
+        }
+    }
+
+    private static final int DNS_TIMEOUT_MS = 1400;
+    private static final int TCP_TIMEOUT_MS = 1800;
+    private static final int TLS_TIMEOUT_MS = 2200;
+    private static final int MAX_CANDIDATES = 32;
+
+    private static final Pattern JSON_A = Pattern.compile(
+            "\\\"data\\\"\\s*:\\s*\\\"([0-9]{1,3}(?:\\.[0-9]{1,3}){3})\\\"");
+
+    private SmartRelaySelector() { }
+
+    public static Endpoint parseEndpoint(String serverAddress) throws Exception {
+        String s = serverAddress == null ? "" : serverAddress.trim();
+        if (s.length() == 0)
+            throw new IllegalArgumentException("empty server address");
+        if (!s.matches("^[a-zA-Z][a-zA-Z0-9+.-]*://.*"))
+            s = "https://" + s;
+        URI u = new URI(s);
+        String host = u.getHost();
+        if (host == null || host.length() == 0)
+            throw new IllegalArgumentException("no hostname in " + serverAddress);
+        int port = u.getPort() > 0 ? u.getPort() : 443;
+        return new Endpoint(host, port);
+    }
+
+    /** Cross-profile relay sharing is disabled in the public build. */
+    public static boolean isKeeneticCloudHost(String host) {
+        return false;
+    }
+
+    public static Selection select(String serverAddress,
+                                   Iterable<String> relatedServerAddresses,
+                                   String cachedCsv,
+                                   SocketProtector protector,
+                                   Logger logger) {
+        final Endpoint endpoint;
+        try {
+            endpoint = parseEndpoint(serverAddress);
+        } catch (Exception e) {
+            log(logger, "SMART RELAY: address parse failed: " + e.getMessage());
+            return null;
+        }
+
+        final LinkedHashSet<String> pool = new LinkedHashSet<String>();
+        addCsv(pool, cachedCsv);
+
+        // System resolver is cheap and often gives the carrier-specific pair.
+        addSystemDNS(pool, endpoint.host, logger);
+
+        final LinkedHashSet<String> discoveryHosts = new LinkedHashSet<String>();
+        discoveryHosts.add(endpoint.host);
+        if (isKeeneticCloudHost(endpoint.host) && relatedServerAddresses != null) {
+            for (String addr : relatedServerAddresses) {
+                try {
+                    Endpoint e = parseEndpoint(addr);
+                    if (isKeeneticCloudHost(e.host))
+                        discoveryHosts.add(e.host);
+                } catch (Exception ignored) { }
+            }
+        }
+
+        // Public DoH views are queried concurrently.  This is intentionally
+        // additive: system DNS remains a source and private/non-public names
+        // continue to work even if DoH is blocked.
+        ExecutorService discoveryExec = Executors.newFixedThreadPool(4);
+        List<Future<Set<String>>> discovery = new ArrayList<Future<Set<String>>>();
+        for (final String host : discoveryHosts) {
+            discovery.add(discoveryExec.submit(new Callable<Set<String>>() {
+                @Override public Set<String> call() {
+                    return queryGoogle(host);
+                }
+            }));
+            discovery.add(discoveryExec.submit(new Callable<Set<String>>() {
+                @Override public Set<String> call() {
+                    return queryCloudflare(host);
+                }
+            }));
+            // Also ask the system resolver for other configured Keenetic hosts.
+            if (!host.equals(endpoint.host))
+                addSystemDNS(pool, host, logger);
+        }
+        discoveryExec.shutdown();
+        for (Future<Set<String>> f : discovery) {
+            try {
+                Set<String> result = f.get(DNS_TIMEOUT_MS + 500L, TimeUnit.MILLISECONDS);
+                synchronized (pool) {
+                    for (String ip : result)
+                        if (isIPv4(ip) && pool.size() < MAX_CANDIDATES)
+                            pool.add(ip);
+                }
+            } catch (Exception ignored) { }
+        }
+        discoveryExec.shutdownNow();
+
+        if (pool.isEmpty()) {
+            log(logger, "SMART RELAY: no candidate IPs discovered; using normal DNS");
+            return new Selection(endpoint, null, Collections.<Candidate>emptyList(), "");
+        }
+
+        log(logger, "SMART RELAY: discovered " + pool.size() + " candidate(s): " + join(pool));
+
+        ExecutorService probeExec = Executors.newFixedThreadPool(Math.min(8, pool.size()));
+        List<Future<Candidate>> probes = new ArrayList<Future<Candidate>>();
+        for (final String ip : pool) {
+            probes.add(probeExec.submit(new Callable<Candidate>() {
+                @Override public Candidate call() {
+                    return probe(endpoint.host, endpoint.port, ip, protector);
+                }
+            }));
+        }
+        probeExec.shutdown();
+
+        List<Candidate> candidates = new ArrayList<Candidate>();
+        for (Future<Candidate> f : probes) {
+            try {
+                candidates.add(f.get(TCP_TIMEOUT_MS + TLS_TIMEOUT_MS + 1000L,
+                        TimeUnit.MILLISECONDS));
+            } catch (Exception ignored) { }
+        }
+        probeExec.shutdownNow();
+
+        Collections.sort(candidates, new Comparator<Candidate>() {
+            @Override public int compare(Candidate a, Candidate b) {
+                return Long.compare(a.score(), b.score());
+            }
+        });
+
+        for (Candidate c : candidates) {
+            if (c.tlsOk) {
+                log(logger, "SMART RELAY: " + c.ip + " OK tcp=" + c.tcpMs +
+                        "ms tls=" + c.tlsMs + "ms");
+            } else if (c.tcpOk) {
+                log(logger, "SMART RELAY: " + c.ip + " TCP-ONLY tcp=" + c.tcpMs +
+                        "ms (TLS probe: " + c.error + ")");
+            } else {
+                log(logger, "SMART RELAY: " + c.ip + " FAIL " + c.error);
+            }
+        }
+
+        String selected = null;
+        for (Candidate c : candidates) {
+            if (c.tlsOk) {
+                selected = c.ip;
+                break;
+            }
+        }
+        // Some legitimate VPN gateways use TLS setups that Java cannot probe
+        // but libopenconnect can.  If no TLS probe passed, a working TCP node
+        // is still a better hint than a known-dead address.
+        if (selected == null) {
+            for (Candidate c : candidates) {
+                if (c.tcpOk) {
+                    selected = c.ip;
+                    break;
+                }
+            }
+        }
+
+        if (selected != null)
+            log(logger, "SMART RELAY: selected " + selected + " for " +
+                    endpoint.host + ":" + endpoint.port);
+        else
+            log(logger, "SMART RELAY: no healthy candidate; falling back to normal DNS");
+
+        return new Selection(endpoint, selected,
+                Collections.unmodifiableList(candidates), join(pool));
+    }
+
+    private static void addSystemDNS(Set<String> pool, String host, Logger logger) {
+        try {
+            InetAddress[] arr = InetAddress.getAllByName(host);
+            synchronized (pool) {
+                for (InetAddress a : arr) {
+                    if (a instanceof Inet4Address && pool.size() < MAX_CANDIDATES)
+                        pool.add(a.getHostAddress());
+                }
+            }
+        } catch (Exception e) {
+            log(logger, "SMART RELAY: system DNS failed for " + host + ": " +
+                    e.getClass().getSimpleName());
+        }
+    }
+
+    private static Set<String> queryGoogle(String host) {
+        try {
+            String q = URLEncoder.encode(host, "UTF-8");
+            return queryJson("https://dns.google/resolve?name=" + q + "&type=A");
+        } catch (Exception e) {
+            return Collections.emptySet();
+        }
+    }
+
+    private static Set<String> queryCloudflare(String host) {
+        try {
+            String q = URLEncoder.encode(host, "UTF-8");
+            return queryJson("https://cloudflare-dns.com/dns-query?name=" + q + "&type=A");
+        } catch (Exception e) {
+            return Collections.emptySet();
+        }
+    }
+
+    private static Set<String> queryJson(String url) {
+        LinkedHashSet<String> out = new LinkedHashSet<String>();
+        HttpURLConnection c = null;
+        try {
+            c = (HttpURLConnection)new java.net.URL(url).openConnection();
+            c.setConnectTimeout(DNS_TIMEOUT_MS);
+            c.setReadTimeout(DNS_TIMEOUT_MS);
+            c.setRequestProperty("Accept", "application/dns-json, application/json");
+            c.setRequestProperty("Cache-Control", "no-cache");
+            c.setRequestProperty("User-Agent", "SmartOpenConnect/0.1");
+            int code = c.getResponseCode();
+            if (code < 200 || code >= 300)
+                return out;
+            InputStream in = c.getInputStream();
+            BufferedReader br = new BufferedReader(new InputStreamReader(in,
+                    StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = br.readLine()) != null && sb.length() < 256 * 1024)
+                sb.append(line);
+            br.close();
+            Matcher m = JSON_A.matcher(sb.toString());
+            while (m.find()) {
+                String ip = m.group(1);
+                if (isIPv4(ip))
+                    out.add(ip);
+            }
+        } catch (Exception ignored) {
+        } finally {
+            if (c != null)
+                c.disconnect();
+        }
+        return out;
+    }
+
+    private static Candidate probe(String host, int port, String ip, SocketProtector protector) {
+        Socket raw = null;
+        SSLSocket ssl = null;
+        long tcpMs = -1;
+        long tlsMs = -1;
+        boolean tcpOk = false;
+        boolean tlsOk = false;
+        String error = "";
+        try {
+            long t = System.nanoTime();
+            raw = new Socket();
+            if (protector != null && !protector.protect(raw))
+                throw new java.io.IOException("VpnService.protect() failed");
+            raw.connect(new InetSocketAddress(ip, port), TCP_TIMEOUT_MS);
+            tcpMs = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - t);
+            tcpOk = true;
+            raw.setSoTimeout(TLS_TIMEOUT_MS);
+
+            TrustManager[] trustAll = new TrustManager[] { new X509TrustManager() {
+                @Override public X509Certificate[] getAcceptedIssuers() {
+                    return new X509Certificate[0];
+                }
+                @Override public void checkClientTrusted(X509Certificate[] chain, String authType) { }
+                @Override public void checkServerTrusted(X509Certificate[] chain, String authType) { }
+            }};
+            SSLContext ctx = SSLContext.getInstance("TLS");
+            ctx.init(null, trustAll, new SecureRandom());
+            SSLSocketFactory sf = ctx.getSocketFactory();
+
+            // Wrapping the already-connected IP socket with the logical host
+            // preserves SNI while keeping the physical destination fixed.
+            t = System.nanoTime();
+            ssl = (SSLSocket)sf.createSocket(raw, host, port, true);
+            raw = null;
+            ssl.setSoTimeout(TLS_TIMEOUT_MS);
+            ssl.startHandshake();
+            tlsMs = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - t);
+            tlsOk = true;
+        } catch (Exception e) {
+            error = e.getClass().getSimpleName();
+            if (e.getMessage() != null && e.getMessage().length() > 0)
+                error += ": " + e.getMessage();
+        } finally {
+            try { if (ssl != null) ssl.close(); } catch (Exception ignored) { }
+            try { if (raw != null) raw.close(); } catch (Exception ignored) { }
+        }
+        return new Candidate(ip, tcpOk, tlsOk, tcpMs, tlsMs, error);
+    }
+
+    private static void addCsv(Set<String> pool, String csv) {
+        if (csv == null)
+            return;
+        for (String s : csv.split("[,\\s]+")) {
+            s = s.trim();
+            if (isIPv4(s) && pool.size() < MAX_CANDIDATES)
+                pool.add(s);
+        }
+    }
+
+    private static boolean isIPv4(String ip) {
+        if (ip == null || !ip.matches("^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"))
+            return false;
+        String[] parts = ip.split("\\.");
+        for (String p : parts) {
+            try {
+                int v = Integer.parseInt(p);
+                if (v < 0 || v > 255)
+                    return false;
+            } catch (Exception e) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static String join(Iterable<String> values) {
+        StringBuilder sb = new StringBuilder();
+        for (String s : values) {
+            if (sb.length() != 0)
+                sb.append(',');
+            sb.append(s);
+        }
+        return sb.toString();
+    }
+
+    private static void log(Logger logger, String line) {
+        if (logger != null)
+            logger.log(line);
+    }
+}
